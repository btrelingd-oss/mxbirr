rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'beamlakub9@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      // Allow reading user profiles so leaderboards, admin management, and multiplayer player info can load
      allow read: if true;
      
      // Allow user profile creation and syncs for phone-based logins, anonymous auth, and registered accounts
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Phone Logins Collection - Audit history of name & phone number logins
    match /phone_logins/{loginId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Spins Collection
    match /spins/{spinId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Spin records are provably fair and immutable
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // Chat Messages Collection
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
